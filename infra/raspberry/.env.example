# Copiar como .env. Nunca versionar el archivo real.
JWT_SECRET=generate-at-least-32-random-characters
CLOUDFLARE_TUNNEL_TOKEN=

# DuckDB snapshots from the shared R2 bucket
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=motoshop-gold

# Primary OpenAI-compatible LLM provider
GO_API_BASE=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
GO_MODEL=qwen3.6-plus
GO_MAX_TOKENS=800
LLM_TIMEOUT=120

# Optional independent fallback provider
ZEN_API_BASE=https://opencode.ai/zen/v1
OPENCODE_API_KEY_FALLBACK=
ZEN_MODEL=deepseek-v4-flash-free
ZEN_MAX_TOKENS=8000

# Optional document RAG. Transactional tools work without these.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

CORS_ORIGINS=https://app.fragloesja.uk,https://motoshop-web-tau.vercel.app

